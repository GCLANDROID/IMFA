<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/lnBalance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/lldesign9"
                            android:padding="10dp"
                            android:backgroundTint="@color/appYellow">
                            <TextView
                                android:layout_gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.5"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="Work From Home"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="0.8"
                                android:orientation="vertical">
                                <TextView
                                    android:text="0.00"
                                    android:id="@+id/tvWFHTaken"
                                    android:layout_gravity="center"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="16sp"
                                    android:textColor="@color/black"></TextView>
                                <View
                                    android:padding="5dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/black"></View>
                                <TextView
                                    android:text="0.00"
                                    android:id="@+id/tvWFHOpening"
                                    android:layout_gravity="center"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="16sp"
                                    android:textColor="@color/black"></TextView>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvEmpName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            tools:text="Applicant name "
                            android:layout_marginTop="10dp"
                            android:textColor="@color/appBlack"/>

                        <TextView
                            android:layout_marginTop="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:id="@+id/tvApproverName"
                            tools:text="Approver name"
                            android:textColor="@color/color3"/>

                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.2">
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp">



                            <LinearLayout
                                android:id="@+id/llLeaveApplication"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="visible">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginTop="10dp">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">
                                        <TextView
                                            android:id="@+id/tvLeaveModeName"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/black"
                                            android:text="Day Mode:"/>

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/red"
                                            android:text="*"/>

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_marginTop="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:background="@drawable/lldesign4">
                                        <Spinner
                                            android:id="@+id/spDayMode"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"/>
                                    </LinearLayout>

                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginTop="10dp">
                                    <TextView
                                        android:id="@+id/tvContactName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/appYellow"
                                        android:text="Emergency Contact:*"
                                        android:visibility="gone"/>
                                    <LinearLayout
                                        android:layout_marginTop="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:visibility="gone"
                                        android:background="@drawable/lldesign4">
                                        <EditText
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:textSize="12sp"
                                            android:paddingLeft="5dp"
                                            android:background="@null"
                                            android:inputType="number"
                                            android:maxLength="10"/>
                                    </LinearLayout>

                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginTop="10dp">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">
                                        <TextView
                                            android:id="@+id/tvStartDateName"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/black"
                                            android:text="Start Date:"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/red"
                                            android:text="*"/>
                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/llStrtDate"
                                        android:layout_marginTop="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:background="@drawable/lldesign4">
                                        <ImageView
                                            android:id="@+id/imgStrtDay"
                                            android:layout_gravity="center"
                                            android:layout_marginLeft="5dp"
                                            android:layout_width="25dp"
                                            android:layout_height="25dp"
                                            android:src="@drawable/calendericon"/>
                                        <TextView
                                            android:layout_marginLeft="10dp"
                                            android:layout_gravity="center"
                                            android:id="@+id/tvStrtDate"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:paddingLeft="5dp"
                                            android:textColor="@android:color/black"/>
                                    </LinearLayout>

                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginTop="10dp">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">
                                        <TextView
                                            android:id="@+id/tvEndDateName"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/black"
                                            android:text="End Date:"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/red"
                                            android:text="*"/>
                                    </LinearLayout>


                                    <LinearLayout
                                        android:id="@+id/llEndDate"
                                        android:layout_marginTop="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:background="@drawable/lldesign4">
                                        <ImageView
                                            android:id="@+id/imgEndDay"
                                            android:layout_gravity="center"
                                            android:layout_marginLeft="5dp"
                                            android:layout_width="25dp"
                                            android:layout_height="25dp"
                                            android:src="@drawable/calendericon"></ImageView>
                                        <TextView
                                            android:layout_marginLeft="5dp"
                                            android:layout_gravity="center"
                                            android:id="@+id/tvEndDate"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:paddingLeft="5dp"
                                            android:textColor="@android:color/black"></TextView>
                                    </LinearLayout>

                                </LinearLayout>
                                <LinearLayout
                                    android:visibility="gone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginTop="10dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/color1"
                                        android:text="Reference Name"/>
                                    <LinearLayout
                                        android:layout_marginTop="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:background="@drawable/lldesign4">
                                        <Spinner
                                            android:id="@+id/spRefName"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"></Spinner>
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginTop="10dp">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">
                                        <TextView
                                            android:id="@+id/tvWorkPlace"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/black"
                                            android:text="Work Place:"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/red"
                                            android:text="*"/>
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_marginTop="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="50dp"
                                        android:background="@drawable/lldesign4">
                                        <EditText
                                            android:id="@+id/etWorkPlace"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:textSize="12sp"
                                            android:paddingLeft="5dp"
                                            android:background="@null"
                                            ></EditText>
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginTop="10dp">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">
                                        <TextView
                                            android:id="@+id/tvReasonName"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/black"
                                            android:text="Reason:"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textSize="12sp"
                                            android:textStyle="bold"
                                            android:textColor="@color/red"
                                            android:text="*"/>
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_marginTop="5dp"
                                        android:layout_width="match_parent"
                                        android:layout_height="70dp"
                                        android:background="@drawable/lldesign4">
                                        <EditText
                                            android:id="@+id/etReason"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:textSize="12sp"
                                            android:paddingLeft="5dp"
                                            android:background="@null"/>
                                    </LinearLayout>
                                </LinearLayout>


                                <LinearLayout
                                    android:visibility="visible"
                                    android:id="@+id/llSubmit"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginRight="10dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="20dp"
                                    android:gravity="center"
                                    android:background="@drawable/lldesigngreen">
                                    <TextView
                                        android:id="@+id/tvPreviewName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="13sp"
                                        android:textColor="@android:color/white"
                                        android:text="Submit"/>
                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/llLeaveEncashment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtEcashmentDuringYear"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textSize="12sp"/>

                                <TextView
                                    android:id="@+id/txtEncashApproverName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Approver Name: "
                                    android:textColor="#F44336"
                                    android:textStyle="bold"
                                    android:textSize="12sp"
                                    android:layout_marginTop="10dp"/>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight=".8"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/appYellow"
                                        android:text="Leave Type*"/>

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.2"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/appYellow"
                                        android:text="No. of Leave*"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/llPLA"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:visibility="gone"
                                    android:layout_marginTop="5dp">

                                    <EditText
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:layout_weight=".8"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:focusable="false"
                                        android:text="PRIVILEGE LEAVE ACCRUAL"
                                        android:paddingStart="5dp"
                                        android:textColor="@color/barcolor"
                                        android:layout_marginEnd="5dp"
                                        android:background="@drawable/lldesign4"/>

                                    <EditText
                                        android:id="@+id/etPlaNumber"
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:layout_weight="1.2"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:inputType="number"
                                        android:textColor="@color/black"
                                        android:hint="No. of Leave"
                                        android:paddingStart="5dp"
                                        android:background="@drawable/lldesign4"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:visibility="gone"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight=".8"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/appYellow"
                                        android:text="Leave Type*"/>

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.2"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/appYellow"
                                        android:text="No. of Leave*"/>

                                </LinearLayout>


                                <LinearLayout
                                    android:id="@+id/llPLC"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:visibility="gone"
                                    android:layout_marginTop="5dp">

                                    <EditText
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:layout_weight=".8"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:focusable="false"
                                        android:text="PRIVILEGE LEAVE COMPULSORY"
                                        android:paddingStart="5dp"
                                        android:textColor="@color/barcolor"
                                        android:layout_marginEnd="5dp"
                                        android:background="@drawable/lldesign4"/>

                                    <EditText
                                        android:id="@+id/etPlcNumber"
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:layout_weight="1.2"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/black"
                                        android:hint="No. of Leave"
                                        android:inputType="number"
                                        android:paddingStart="5dp"
                                        android:background="@drawable/lldesign4"/>

                                </LinearLayout>


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:visibility="gone"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight=".8"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/appYellow"
                                        android:text="Leave Type*"/>

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.2"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/appYellow"
                                        android:text="No. of Leave*"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="5dp">

                                    <EditText
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:layout_weight=".8"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:text="TOTAL LEAVE ENCASHMENT"
                                        android:focusable="false"
                                        android:paddingStart="5dp"
                                        android:textColor="@color/barcolor"
                                        android:layout_marginEnd="5dp"
                                        android:background="@drawable/lldesign4"/>

                                    <EditText
                                        android:id="@+id/etTotalNumberOfEncasement"
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:layout_weight="1.2"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/black"
                                        android:hint="No. of Leave"
                                        android:focusable="false"
                                        android:paddingStart="5dp"
                                        android:background="@drawable/lldesign4"/>

                                </LinearLayout>


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:visibility="gone"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight=".8"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/appYellow"
                                        android:text="Payable Year"/>

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1.2"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/appYellow"
                                        android:text="Payable Month"/>

                                </LinearLayout>


                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:visibility="gone"
                                    android:orientation="horizontal">

                                    <LinearLayout

                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:layout_weight=".8"
                                        android:layout_marginEnd="5dp"
                                        android:background="@drawable/lldesign4">
                                        <Spinner
                                            android:id="@+id/spPayableYear"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            ></Spinner>
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="30dp"
                                        android:layout_weight="1.2"
                                        android:background="@drawable/lldesign4">
                                        <Spinner
                                            android:id="@+id/spPayableMonth"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            ></Spinner>
                                    </LinearLayout>

                                </LinearLayout>


                                <LinearLayout
                                    android:id="@+id/llEncasmentSubmit"
                                    android:layout_width="match_parent"
                                    android:layout_height="40dp"
                                    android:layout_marginLeft="10dp"
                                    android:layout_marginTop="30dp"
                                    android:layout_marginRight="10dp"
                                    android:layout_marginBottom="20dp"
                                    android:background="@drawable/app_color_button_background"
                                    android:gravity="center"
                                    android:visibility="visible">

                                    <TextView
                                        android:id="@+id/tvEncasmentName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="SUBMIT"
                                        android:textColor="@android:color/white"
                                        android:textSize="13sp"></TextView>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvImportantPoint"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="* Important Point"
                                    android:textStyle="bold"
                                    android:paddingEnd="5dp"
                                    android:paddingTop="5dp"
                                    android:paddingBottom="5dp"
                                    android:textColor="#0027FF"/>

                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llLoader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#9FD5D2D2"
                android:gravity="center">
                <ProgressBar
                    android:layout_width="50dp"
                    android:layout_height="50dp"></ProgressBar>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>



</layout>